# Server-side only (set in Vercel > Project > Settings > Environment Variables).
# Get a key at https://aistudio.google.com/apikey . Never prefix with VITE_.
GEMINI_API_KEY=
# Model IDs (Gemma 4 via the Gemini API). Fallback is used if the primary errors.
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_FALLBACK_MODEL=gemma-4-31b-it

# Only needed by the offline data pipeline (data/build.py), not by the app.
# Free token: https://www.huduser.gov/hudapi/public/register
HUD_USER_TOKEN=

# Browser key for Google Street View Static API, baked into the site at build time (so the VITE_ prefix is
# right here). Restrict it in Google Cloud to this site's address and to the Street View Static API only.
# Leave empty to show aerial views only.
VITE_GOOGLE_MAPS_KEY=
